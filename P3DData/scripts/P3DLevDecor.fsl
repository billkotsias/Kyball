Node SeagullNode {
	pos { x 0 y 0 z 2 }
	nodes [
		{
			animators [ { t Animator::oscillate osWi 1.5 s 2 } ]
			scale { x 0.02 y 0.02 z 0.02 }
			rot [ 0 0 180 ]
			entities [ { obj "Seagull" anims [ { n "anim" s 1.5 } ] } ]
		}
	]
}
Node seagulls {
	nodes [
		{
			animators [ { t Animator::ellipse elMa 100 elMi 100 elFi 180 elAngle 180 start -30 s -0.13 } ]
			pos { x 0 y 10 z 10 }
			nodes [ SeagullNode ]
		}
		{
			animators [ { t Animator::ellipse elMa 120 elMi 80 elFi 180 elAngle 180 start -30 s -0.13 } ]
			pos { x 0 y 10 z 10 }
			nodes [ SeagullNode ]
		}
		{
			animators [ { t Animator::ellipse elMa 80 elMi 120 elFi 180 elAngle 180 s -0.13 } ]
			pos { x 0 y 10 z 10 }
			nodes [ SeagullNode ]
		}
	]
}
