// default values for all sounds
class Sound {
	string name	""			/// name = file path
	int priority true		/// true = high priority, false = low priority
	int streamed false		/// true = streamed, false = buffered
	real refDistance 3.5	/// maximum volume when source's distance is <= refDistance
	real rolloff 1.05		/// (was:1.75) amount of sound attenuation relative to distance (0 = no attenuation)
	real maxDistance 100000	/// sound isn't attenuated after this distance (don't touch)
	real volume 1			/// default sound volume (min = 0, max = 1)
	real pitch 1			/// default sound pitch (min = 0, max = oo)
	int loop false
}
// TODO KYBALL2 : allow different file source to name (so different, or even RANDOM(!) pitches can be used!)
// for better explanation see http://connect.creativelabs.com/openal/Documentation/OpenAL%201.1%20Specification.htm#_Toc199835864
// NOTE : Stereo sounds are NOT played in 3D!

// instances of class 'Sound' : if we need to change the default values for a sound, we simply declare it
array of Sound sounds [

	// default-values holders; don't initialize as they don't correspond to any sound files!
	{	name "<ambience>"
