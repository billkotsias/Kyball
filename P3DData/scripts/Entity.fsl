class AnimationState {
	string n ""	// animation name
	real s 1	// speed
	real d 0	// initial delay
}

enum ASLoopType {
	none
	loop
	random
	combined	// not inserted yet, but exists as a separate "AnimationStatesCombined.h"!
}

class ASCommon {
	int loop ASLoopType::loop
	real pos NaN	// time-position at start (default=randomized)
}

class Obj3D {
	string mesh ""					// corresponding mesh name
	array of string material [ ]	// override mesh default if set (one material for each subentity, or just one for the whole entity)
	int buildTanVec false			// build tangent vectors?
	int shadow false				// cast shadows?
}

// class Entity {}
