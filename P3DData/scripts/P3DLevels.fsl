	//s0
	{	z 7
		expert 55000
		ambient { r 0.5 g 0.45 b 0.33 }
		background { r 1 g 0.90 b 0.66 } fog { set true exp 0.02 }
		skybox { name "savanna_morning" rot [ 0 0 0 ] }
		nodes [ sava_dry ]
		sounds [
			{ sInterval 0 n [ savanna_morning ] }
		]
		balls [
			[ -3 3 4 c::g ]
