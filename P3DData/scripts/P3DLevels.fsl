// cheat stuff
enum CosmosID {
	ARCTIC
	FOREST
	BATCAVE
	REEF
	HALLOWEEN
	SAVANNA
	DESERT
	BEACH
}
int currentCosmos CosmosID::FOREST
int currentLevel 5
// // cheat stuff

array of int chapters [
	[ CosmosID::BEACH ]
	[ CosmosID::ARCTIC CosmosID::FOREST CosmosID::DESERT ]
	[ CosmosID::SAVANNA CosmosID::REEF CosmosID::BATCAVE CosmosID::HALLOWEEN ]
]

