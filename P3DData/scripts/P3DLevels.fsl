// DESERT
array of Level desert [
	//d0
	{
		skybox { name "sahara_day" rot [ 0 120 0 ] }
		background { r 1.5 g 1.4 b 1.2 }
		fog { set true exp 0.00008 }
		nodes [ desertDay ]
		sounds [
			{ sInterval 0 n [ desert_morning ] }
		]
		hint d0

		expert 60000
		balls [
			[ -1 5 5 c::m ]
			[ -1 5 4 c::r ]
